JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
GOOGLE_MAPS_API_KEY=replace-with-server-maps-key
DATABASE_URL=postgresql://postgres:postgres@localhost/travel_allowance
CORS_ORIGINS=http://localhost:5173,http://192.168.0.3:5173
UPLOAD_ROOT=uploads

# Optional. Required only when Expo Push Service access-token security is enabled.
EXPO_ACCESS_TOKEN=

# Optional (local dev/tests only): auto-create schema from SQLAlchemy models.
# Keep this disabled in production and run Alembic migrations instead.
AUTO_CREATE_SCHEMA=false

# Therapist workday close policy (India local time).
WORKDAY_END_TIME=18:00
WORKDAY_AUTO_LOGOUT_ENABLED=false
WORKDAY_AUTO_LOGOUT_GRACE_MINUTES=15

# Report generation. Database artifact storage is the zero-configuration
# fallback. For production scale, use a private S3-compatible bucket and grant
# the runtime only GetObject/PutObject/DeleteObject on the configured prefix.
REPORT_ASYNC_ROW_THRESHOLD=1000
REPORT_ARTIFACT_STORAGE=database
REPORT_ARTIFACT_S3_BUCKET=
REPORT_ARTIFACT_S3_PREFIX=private/report-exports
REPORT_ARTIFACT_S3_REGION=ap-south-1
REPORT_ARTIFACT_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are resolved by boto3 when needed;
# prefer workload/instance identity instead of static credentials in production.

# Optional one-time/idempotent Render administrator seed.
SEED_ADMIN_ON_STARTUP=false
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=admin
RESET_ADMIN_PASSWORD=false
PROMOTE_EXISTING_ADMIN=false
